{
  "name": "letrando-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Letrando backend — Cloud Functions for Firebase",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "test:books:smoke": "node scripts/books_smoke.mjs",
    "test:learning:smoke": "node scripts/learning_summary_smoke.mjs",
    "test:stories:smoke": "node scripts/stories_smoke.mjs",
    "lint": "eslint src",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy:dev": "firebase deploy --only functions --project dev",
    "deploy:staging": "firebase deploy --only functions --project staging",
    "deploy:production": "firebase deploy --only functions --project production",
    "seed": "node scripts/seed_content.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
