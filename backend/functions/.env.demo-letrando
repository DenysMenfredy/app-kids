# Params for local emulator runs under the throwaway `demo-letrando` project.
#
# Every value here is fake. Stripe is never called locally — the payment
# functions load with these so the emulator doesn't stop to prompt for them,
# and any real checkout attempt against the emulator will simply fail.
# Real values live in Secret Manager / per-environment config (see README).
STRIPE_SECRET_KEY=sk_test_emulator_placeholder
STRIPE_WEBHOOK_SECRET=whsec_emulator_placeholder
STRIPE_PRICE_FOUNDER_MONTHLY=price_demo_monthly
STRIPE_PRICE_FOUNDER_QUARTERLY=price_demo_quarterly
STRIPE_PRICE_FOUNDER_ANNUAL=price_demo_annual
CHECKOUT_RETURN_URL=http://localhost:4000/checkout
# Supply this explicitly: the emulator CLI prompts even when defineString
# has a default, leaving every callable unavailable until it is answered.
STRIPE_WEB_CHECKOUT_APP_ID=disabled
