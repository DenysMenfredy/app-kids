rules_version = '2';

// Letrando — Firestore Security Rules
//
// Trust model (spec §12–§16):
//   - The mobile client is untrusted.
//   - Clients may read/write only their own user-centric data, and may never
//     touch privileged state (roles, subscriptions, entitlements, webhooks).
//   - Subscription/entitlement/role writes happen exclusively in Cloud
//     Functions through the Admin SDK (which bypasses these rules).
//   - Published catalog metadata is readable by authenticated users; activity
//     and story payloads require the first-module-free/Premium policy.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canManageChildProfile() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com'
        || request.auth.token.firebase.sign_in_provider == 'apple.com';
    }

    function incomingKeysOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // Client-writable user profile fields. Privileged fields (role,
    // stripeCustomerId, ...) are absent from this list, so any attempt to
    // write them is rejected.
    function validUserProfile() {
      return incomingKeysOnly([
        'email', 'displayName', 'locale', 'timezone',
        'onboardingState', 'createdAt', 'updatedAt'
      ]);
    }

    function userEditableKeys() {
      return ['displayName', 'locale', 'timezone', 'onboardingState', 'updatedAt'];
    }

    function childEditableKeys() {
      return ['name', 'birthDate', 'age', 'avatarId', 'updatedAt'];
    }

    function validEditableUserProfile() {
      let data = request.resource.data;
      return data.get('displayName', '') is string
        && data.get('displayName', '').size() <= 120
        && data.get('locale', 'pt-BR') is string
        && data.get('locale', 'pt-BR').size() <= 16
        && data.get('timezone', 'America/Sao_Paulo') is string
        && data.get('timezone', 'America/Sao_Paulo').size() <= 64
        && data.get('onboardingState', '') is string
        && data.get('onboardingState', '').size() <= 64;
    }

    function validEditableChildProfile() {
      let data = request.resource.data;
      return data.get('name', '') is string
        && data.get('name', '').size() > 0
        && data.get('name', '').size() <= 80
        && data.get('age', 0) is int
        && data.get('age', 0) >= 3
        && data.get('age', 0) <= 7
        && data.get('avatarId', '') is string
        && data.get('avatarId', '').size() > 0
        && data.get('avatarId', '').size() <= 64
        && data.get('birthDate', '') is string
        && data.get('birthDate', '').size() <= 10;
    }

    function validChangedTimestamp() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time;
    }

    // Child-data constraint (spec §4, §19): minimum required data only.
    // school / address / precise location / phone / photos are not allowed.
    function validChild() {
      return incomingKeysOnly([
        'name', 'birthDate', 'age', 'avatarId', 'learningLevel',
        'currentCourseId', 'currentLessonId', 'createdAt', 'updatedAt'
      ]);
    }

    function validNotificationPreferences() {
      return incomingKeysOnly([
        'dailyReminder', 'achievement', 'weeklyReport', 'subscription',
        'marketing', 'preferredTime', 'updatedAt'
      ]);
    }

    function isPublished() {
      return resource.data.published == true;
    }

    function hasFullCurriculumEntitlement(uid) {
      let entitlementPath = /databases/$(database)/documents/users/$(uid)/entitlements/premium;
      return exists(entitlementPath)
        && get(entitlementPath).data.active == true
        && get(entitlementPath).data.features is list
        && get(entitlementPath).data.features.hasAny(['full_curriculum'])
        && get(entitlementPath).data.validFrom is timestamp
        && get(entitlementPath).data.validFrom <= request.time
        && get(entitlementPath).data.validUntil is timestamp
        && get(entitlementPath).data.validUntil > request.time;
    }

    function canAccessModule(moduleId) {
      let modulePath = /databases/$(database)/documents/modules/$(moduleId);
      return exists(modulePath)
        && get(modulePath).data.published == true
        && (get(modulePath).data.number == 1
          || hasFullCurriculumEntitlement(request.auth.uid));
    }

    function hasPremiumBooksEntitlement(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/entitlements/premium;
      return exists(path) && get(path).data.active == true
        && get(path).data.features is list
        && get(path).data.features.hasAny(['premium_books'])
        && get(path).data.validFrom is timestamp
        && get(path).data.validFrom <= request.time
        && get(path).data.validUntil is timestamp
        && get(path).data.validUntil > request.time;
    }

    function canReadBook(bookId) {
      let path = /databases/$(database)/documents/books/$(bookId);
      return exists(path) && get(path).data.published == true
        && get(path).data.schemaVersion == 1
        && get(path).data.pageCount is int && get(path).data.pageCount > 0
        && get(path).data.pageCount <= 40
        && (get(path).data.access == 'free'
          || (get(path).data.access == 'premium'
            && hasPremiumBooksEntitlement(request.auth.uid)));
    }

    function canReadLessonPayload(lessonId) {
      let lessonPath = /databases/$(database)/documents/lessons/$(lessonId);
      return exists(lessonPath)
        && get(lessonPath).data.published == true
        && canAccessModule(get(lessonPath).data.moduleId);
    }

    // ---------- user-centric private data ----------

    match /users/{uid} {
      allow read: if isOwner(uid);
      // Auth email and createdAt are server-owned. A client may create the
      // profile before the Auth trigger runs, but only with editable fields.
      allow create: if isOwner(uid)
        && incomingKeysOnly(userEditableKeys())
        && validEditableUserProfile()
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt == request.time);
      allow update: if isOwner(uid)
        && validUserProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(userEditableKeys())
        && validEditableUserProfile()
        && validChangedTimestamp();
      allow delete: if false; // account deletion runs through the backend

      match /children/{childId} {
        allow read: if isOwner(uid);
        // Child IDs are allocated by createChildProfile on the server.
        // Parents can edit only the bounded profile fields on existing docs.
        allow create: if false;
        allow update: if isOwner(uid)
          && canManageChildProfile()
          && validChild()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(childEditableKeys())
          && validEditableChildProfile()
          && validChangedTimestamp();
        // Deletion will be a backend lifecycle operation: client deletion
        // would leave progress behind and permit recreate under the same ID.
        allow delete: if false;

        match /bookmarks/{bookId} {
          allow read: if isOwner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/children/$(childId));
          allow write: if false; // validated by saveBookBookmark, no rewards
        }
      }

      match /devices/{deviceId} {
        // Registered/updated exclusively through the registerDevice callable
        // so token bookkeeping stays consistent.
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid);
        allow write: if false; // backend only (spec §13)
      }

      match /entitlements/{entitlementId} {
        allow read: if isOwner(uid);
        allow write: if false; // backend only (spec §13)
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow write: if false; // backend fan-out only
      }

      match /notificationPreferences/{preferenceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNotificationPreferences();
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false; // session evidence is backend-owned
      }

      match /learningProgress/{progressId} {
        allow read: if isOwner(uid);
        allow write: if false; // completion and score are backend-owned
      }

      match /activityAttempts/{attemptId} {
        allow read: if isOwner(uid);
        allow write: if false; // answers and correctness are backend-owned
      }

      match /gamification/{childId} {
        // XP, coins and streak are minted by completeLesson only (ADR 0003).
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /assessmentResults/{childId} {
        // Placement is scored server-side from stored weights (ADR 0003).
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---------- global/shared educational content (read-only) ----------

    match /courses/{courseId} {
      allow read: if signedIn() && isPublished();
      allow write: if false;
    }

    match /modules/{moduleId} {
      allow read: if signedIn() && isPublished();
      allow write: if false;
    }

    match /lessons/{lessonId} {
      allow read: if signedIn() && isPublished();
      allow write: if false;
    }

    match /activities/{activityId} {
      // Activity documents contain answer keys; later modules require the
      // server-written, unexpired full-curriculum entitlement.
      allow read: if signedIn() && isPublished()
        && canReadLessonPayload(resource.data.lessonId);
      allow write: if false;
    }

    match /stories/{storyId} {
      // Module 7's reading texts and their comprehension questions.
      allow read: if signedIn() && isPublished()
        && canReadLessonPayload(resource.data.lessonId);
      allow write: if false;
    }

    match /assessments/{assessmentId} {
      // Questions and option labels are readable; the weights and placement
      // bands they carry are only ever interpreted by the backend.
      allow read: if signedIn() && isPublished();
      allow write: if false;
    }

    match /books/{bookId} {
      // Covers are metadata only; page text lives in bookContents.
      allow read: if signedIn() && isPublished();
      allow write: if false;
    }

    match /bookContents/{bookId} {
      allow get: if signedIn() && isPublished() && canReadBook(bookId)
        && resource.data.schemaVersion == 1
        && resource.data.contentVersion == get(/databases/$(database)/documents/books/$(bookId)).data.contentVersion
        && resource.data.pages is list
        && resource.data.pages.size() == get(/databases/$(database)/documents/books/$(bookId)).data.pageCount;
      allow list, write: if false;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /featureFlags/{flagId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- backend-internal ----------

    match /webhookEvents/{eventId} {
      allow read, write: if false; // Admin SDK only
    }

    // deny-by-default for anything not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
