node_modules/
# Anchored to the compiled output only. An unanchored `lib/` matches at any
# depth, so it also swallowed functions/src/lib/ — four source modules that
# every import in the codebase depends on. They stayed on developer machines
# and were never committed, so CI checked out a tree where `tsc` could not
# resolve them and every build failed. Keep the leading slash.
/functions/lib/
*.log
.env
.env.*
!.env.example
# Fake params so the emulator starts without prompting — no secrets here.
!.env.demo-letrando
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
.emulator-data/

# Content bundles are unpacked into seed/; the archives are provenance only.
*.zip

# Source art dropped here for processing; the optimised copies live in
# lele/assets/images/ and are what ships.
*.png
